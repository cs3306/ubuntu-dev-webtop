# 全部可选:镜像里已有默认值(构建时注入),这里只是运行时覆盖
# PUID=1000
# PGID=1000
# TZ=UTC
# CUSTOM_USER=dev
# PASSWORD=change-me
# 多个公钥用 \n 分隔
# SSH_PUBLIC_KEY="ssh-ed25519 AAAA... you@host"
# 新增登录用户(可选):DEV_UID 默认等于 PUID,与 abc 共享 home 和文件权限
# DEV_USER=ray
# DEV_PASSWORD=change-me
# DEV_SUDO=nopasswd        # nopasswd | password | none
# DEV_UID=
# DEV_GID=
# DEV_HOME=/config
# compose 变量
# DEV_DIR=/path/to/projects
# HTTPS_PORT=3101
# SSH_PORT=2200
# IMAGE=ubuntu-dev-webtop:local
# 运行时扩展(可选,空格分隔,每次启动安装)
# APT_INSTALL=
# PIP_INSTALL=
# NPM_INSTALL=
